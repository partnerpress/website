---
import Button from './Button.astro';
import { perDay, formatPrice, type Plan } from '@/data/plans';

interface Props {
  plan: Plan;
  showPerDay?: boolean;
}

const { plan, showPerDay = false } = Astro.props;
---

<article class:list={['plan', plan.featured && 'plan--featured']}>
  <div class="plan__head">
    <div class="plan__name">
      <h3>{plan.name}</h3>
      {plan.badge && <span class="plan__badge">{plan.badge}</span>}
    </div>
    <p class="plan__for">{plan.bestFor}</p>
  </div>
  <div class="plan__price">
    <span class="plan__amount">{formatPrice(plan.price)}<span>/month</span></span>
    {showPerDay && <span class="plan__day">About {perDay(plan.price)} a day</span>}
  </div>
  <Button href={`/contact/?plan=${plan.name}`} variant={plan.featured ? 'primary' : 'secondary'} block>
    Choose {plan.name}
  </Button>
  <ul class="plan__features">
    {plan.includesPrevious && <li class="plan__includes">{plan.includesPrevious}</li>}
    {plan.features.map((f) => <li>{f}</li>)}
  </ul>
</article>

<style>
  .plan {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .plan--featured {
    padding: 31px;
    border: 2px solid var(--blue);
    box-shadow: var(--shadow-brand);
  }

  .plan__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .plan__name {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  h3 {
    font-size: 26px;
    font-weight: 700;
  }

  .plan__badge {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--blue-700);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
  }

  .plan__for {
    font-size: 15px;
    color: var(--muted);
  }

  .plan__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .plan__amount {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }

  .plan__amount span {
    font-size: 17px;
    font-weight: 500;
    color: var(--muted);
  }

  .plan__day {
    font-size: 14px;
    color: var(--subtle);
  }

  .plan__features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .plan__includes {
    font-weight: 700;
    color: var(--ink);
  }
</style>
