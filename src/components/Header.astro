---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { OFFICES, SERVICE_NAV, SECONDARY_NAV, type NavKey } from '@/config/site';

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
const offices = Object.values(OFFICES);
const aria = (key: NavKey) => (key === current ? 'page' : undefined);
---

<div class="topbar">
  <div class="container topbar__inner">
    <span class="topbar__since">Helping service businesses across the U.S. since 2010</span>
    <span class="topbar__phones">
      {
        offices.map((o) => (
          <span>
            {o.short} <a href={`tel:${o.tel}`}>{o.phone}</a>
          </span>
        ))
      }
    </span>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label="PartnerPress home">
      <img src="/assets/img/logo-color.svg" alt="PartnerPress" width="139" height="40" />
    </a>

    <nav class="nav" aria-label="Main">
      {SERVICE_NAV.map((item) => <a href={item.href} aria-current={aria(item.key)}>{item.label}</a>)}
      <details class="dropdown" data-dropdown>
        <summary class:list={[current === 'locations' && 'is-current']}>
          Locations <Icon name="chevron" size={14} strokeWidth={2.5} />
        </summary>
        <div class="dropdown__panel">
          {
            offices.map((o) => (
              <a href={o.page}>
                <strong>{o.name}</strong>
                <span>
                  {o.city} · {o.phone}
                </span>
              </a>
            ))
          }
        </div>
      </details>
      {SECONDARY_NAV.map((item) => <a href={item.href} aria-current={aria(item.key)}>{item.label}</a>)}
    </nav>

    <Button href="/contact/" class="header__cta">Book a free call</Button>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <Icon name="menu" size={22} class="menu-toggle__open" />
      <Icon name="close" size={22} class="menu-toggle__close" />
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile" hidden>
    <span class="mobile-nav__label">Services</span>
    {SERVICE_NAV.map((item) => <a href={item.href} aria-current={aria(item.key)}>{item.mobileLabel ?? item.label}</a>)}
    <span class="mobile-nav__label">Locations</span>
    {
      offices.map((o) => (
        <a href={o.page}>
          {o.short === 'Marin' ? 'Marin County' : o.short} <span>{o.phone}</span>
        </a>
      ))
    }
    <div class="mobile-nav__small">
      {SECONDARY_NAV.map((item) => <a href={item.href} aria-current={aria(item.key)}>{item.label}</a>)}
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu.hidden = open;
  });

  // Close the Locations dropdown on an outside click or Escape.
  const dropdown = document.querySelector<HTMLDetailsElement>('[data-dropdown]');
  if (dropdown) {
    document.addEventListener('click', (event) => {
      if (dropdown.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dropdown.open) {
        dropdown.open = false;
        dropdown.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .topbar {
    background: var(--blue-900);
    color: var(--blue-100);
    font-size: 14px;
  }

  .topbar__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    justify-content: space-between;
    align-items: center;
    padding-block: 8px;
  }

  .topbar__phones {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .topbar a {
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
  }

  .topbar a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 16px 28px;
    padding-block: 14px;
  }

  .brand {
    display: flex;
    flex: none;
  }

  .brand img {
    height: 40px;
    width: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px 22px;
    margin-left: auto;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
  }

  .nav > a,
  .dropdown > summary {
    padding-block: 8px;
    color: var(--text-strong);
    text-decoration: none;
    cursor: pointer;
  }

  .nav > a:hover,
  .dropdown > summary:hover,
  .nav [aria-current='page'],
  .dropdown > summary.is-current {
    color: var(--blue);
  }

  .dropdown {
    position: relative;
  }

  .dropdown > summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .dropdown[open] > summary :global(svg) {
    transform: rotate(180deg);
  }

  .dropdown__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: -14px;
    z-index: 60;
    min-width: 250px;
    display: flex;
    flex-direction: column;
    padding: 6px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  .dropdown__panel a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text-strong);
    text-decoration: none;
  }

  .dropdown__panel a:hover {
    background: var(--blue-50);
  }

  .dropdown__panel span {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }

  .header :global(.header__cta) {
    flex: none;
  }

  .menu-toggle {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--ink);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .menu-toggle :global(.menu-toggle__close),
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
    display: block;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 72px);
    overflow-y: auto;
    padding: 4px max(16px, env(safe-area-inset-left, 0px)) 20px;
    border-top: 1px solid var(--line);
    background: var(--white);
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 600;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav > a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--surface-2);
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-nav > a span {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  .mobile-nav [aria-current='page'] {
    color: var(--blue);
  }

  .mobile-nav__label {
    padding: 18px 0 4px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--subtle);
  }

  .mobile-nav__small {
    display: flex;
    gap: 24px;
    padding-top: 18px;
    font-size: 17px;
  }

  .mobile-nav__small a {
    color: var(--text-strong);
    text-decoration: none;
  }

  @media (max-width: 1140px) {
    .nav {
      gap: 4px 14px;
      font-size: 14px;
    }
  }

  @media (max-width: 1000px) {
    .nav,
    .header :global(.header__cta) {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .brand img {
      height: 32px;
    }

    .topbar__since {
      display: none;
    }
  }
</style>
