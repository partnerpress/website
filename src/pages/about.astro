---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Split from '@/components/Split.astro';
import Grid from '@/components/Grid.astro';
import Feature from '@/components/Feature.astro';
import Placeholder from '@/components/Placeholder.astro';
import ReviewQuote from '@/components/ReviewQuote.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import { SITE } from '@/config/site';
import { REVIEWS } from '@/data/reviews';

const values = [
  { title: 'Empathy', text: "I start by understanding what you're dealing with, then solve the problem that matters most." },
  { title: 'Transparency', text: 'You see what I did, what it cost and why. Every month, in writing.' },
  { title: 'Generosity', text: "I share what I know and recommend what's best for you, even when it means spending less." },
  { title: 'Simplicity', text: 'Plain English, simple plans, and no more moving parts than your site needs.' },
  { title: 'Accountability', text: 'If something goes wrong, I own it and make it right.' },
  { title: 'Humility', text: "If I don't know something, I'll say so, and I'll find someone who does." },
];

const facts = [
  { value: String(SITE.founded), label: 'Building with WordPress' },
  { value: SITE.reviews.rating, label: `From ${SITE.reviews.count} Google reviews` },
  { value: '2', label: 'Home bases, CA and NM' },
];
---

<BaseLayout
  title="About Shane Barnes, WordPress Expert Since 2010 | PartnerPress"
  description="Meet Shane Barnes: WordPress developer since 2010 helping service businesses in Marin County and Las Cruces get more from their websites."
  nav="about"
>
  <section class="about-hero">
    <div class="container about-hero__inner">
      <Placeholder label="Portrait: Shane, friendly and professional" ratio="4 / 5" class="about-hero__photo" />
      <div class="about-hero__copy">
        <span class="eyebrow about-hero__eyebrow">About PartnerPress</span>
        <h1 class="title-lg">Hi, I'm Shane. Your business is my business.</h1>
        <p class="lead">
          I've been building and caring for WordPress sites since 2010. Today I help local service businesses in Marin
          County and Las Cruces get more from their websites, their Google rankings and their ads.
        </p>
        <dl class="facts">
          {
            facts.map((f) => (
              <div>
                <dt>{f.value}</dt>
                <dd>{f.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <Section>
    <Split>
      <h2 slot="side" class="title-sm">The short version</h2>
      <div class="story">
        <p>
          I discovered WordPress in 2010 and was hooked. Since then I've helped hundreds of businesses, from solo practitioners
          to brands like Sutter Health and Grifols, get websites that are stable, secure and easy to find.
        </p>
        <p>
          Most of my clients come to me after a developer disappeared or a site broke at the worst possible time. My job is to
          take that off your plate, so you can focus on running your business while I handle the website, the rankings and
          the ads.
        </p>
        <p>
          I split my time between Novato, CA and Las Cruces, NM. I'm a husband, a proud stepfather to two boys, and the
          dutiful servant of three scrappy lap dogs. When I'm not at my desk, you'll probably find me on a bike on a back road.
        </p>
      </div>
    </Split>
  </Section>

  <Section tone="subtle">
    <SectionIntro eyebrow="How I work" title="Six things you can count on" />
    <Grid min={260} gap="32px 28px">
      {values.map((v) => <Feature title={v.title}>{v.text}</Feature>)}
    </Grid>
  </Section>

  <Section compact>
    <ReviewQuote review={REVIEWS.gibbsSpend} variant="feature" />
  </Section>

  <Section tone="subtle" compact>
    <Grid min={300}>
      <Feature title="Hours" boxed>{SITE.hours}. If your site goes down, I'm on it any time.</Feature>
      <Feature title="Who I work best with" boxed>
        Established service businesses with clear goals, a marketing budget and a long-term view.
      </Feature>
      <Feature title="Where" boxed>Offices in Novato and Las Cruces, with clients across the country over Zoom.</Feature>
    </Grid>
  </Section>

  <CtaBand title="Let's see if we're a good fit">
    30 minutes, no pressure. Marin <Phone office="marin" /> · Las Cruces <Phone office="nm" />
  </CtaBand>
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--blue-50);
  }

  .about-hero__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: center;
  }

  :global(.about-hero__photo) {
    flex: 1 1 300px;
    max-width: 440px;
  }

  .about-hero__copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .about-hero__eyebrow {
    color: var(--blue-700);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin: 0;
  }

  .facts dt {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
  }

  .facts dd {
    margin: 0;
    font-size: 15px;
    color: var(--text-strong);
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 680px;
    font-size: 18px;
  }
</style>
