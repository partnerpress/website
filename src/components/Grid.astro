---
// Responsive auto-fit grid. `min` is the narrowest a column may get before wrapping.
interface Props {
  min?: number;
  gap?: string;
  as?: 'div' | 'ul' | 'ol';
  class?: string;
}

const { min = 260, gap = '24px', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['grid', className]} style={`--min: ${min}px; --gap: ${gap}`}>
  <slot />
</Tag>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--min), 100%), 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
