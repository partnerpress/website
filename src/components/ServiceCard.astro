---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
  highlight?: boolean;
  /** Show the icon and price line (homepage) or just title and summary. */
  detailed?: boolean;
  /** Override the summary text. */
  summary?: string;
  title?: string;
}

const { service, highlight = false, detailed = true, summary, title } = Astro.props;
---

<a class:list={['card', highlight && 'card--highlight']} href={service.href}>
  {detailed && <Icon name={service.icon} size={32} class="card__icon" />}
  <h3>{title ?? service.title}</h3>
  <p>{summary ?? service.summary}</p>
  {
    detailed && (
      <span class="card__price">
        <strong>{service.price}</strong>
        {service.priceNote && ` · ${service.priceNote}`}
      </span>
    )
  }
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 150ms,
      transform 150ms;
  }

  .card:hover {
    color: var(--text);
    border-color: var(--blue-300);
    transform: translateY(-2px);
  }

  .card--highlight {
    padding: 27px;
    background: var(--blue-50);
    border: 2px solid var(--blue);
  }

  .card :global(.card__icon) {
    color: var(--blue);
  }

  h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0;
  }

  p {
    font-size: 16px;
  }

  .card__price {
    margin-top: auto;
    font-size: 15px;
    color: var(--text-strong);
  }
</style>
