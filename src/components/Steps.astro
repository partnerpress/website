---
// Numbered process steps. The order matters, so they render as an ordered list.
interface Props {
  steps: { title: string; text: string }[];
  min?: number;
}

const { steps, min = 230 } = Astro.props;
---

<ol class="steps" style={`--min: ${min}px`}>
  {
    steps.map((step, i) => (
      <li>
        <span class="steps__num">Step {i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--min), 100%), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 18px;
    border-top: 3px solid var(--blue);
  }

  .steps__num {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--blue);
  }

  h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0;
  }

  p {
    font-size: 16px;
  }
</style>
