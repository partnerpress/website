---
import Icon from './Icon.astro';

interface Props {
  items: string[];
  columns?: boolean;
}

const { items, columns = false } = Astro.props;
---

<ul class:list={['checks', columns && 'checks--columns']}>
  {
    items.map((item) => (
      <li>
        <Icon name="check" size={22} strokeWidth={2.5} class="checks__icon" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .checks {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-strong);
  }

  .checks--columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 16px 32px;
  }

  li {
    display: flex;
    gap: 12px;
  }

  li :global(.checks__icon) {
    flex: none;
    margin-top: 2px;
    color: var(--green);
  }
</style>
