---
// Illustration of a sponsored Google search result. Example text only.
import Icon from '../Icon.astro';
---

<div class="mock" role="img" aria-label="Example of a Google search ad for a local business">
  <div class="mock__search"><Icon name="search" size={18} /> emergency electrician novato</div>
  <div class="ad ad--you" aria-hidden="true">
    <span class="ad__meta"><strong>Sponsored</strong> · yourbusiness.com</span>
    <span class="ad__title">Your Business | Licensed Electrician in Novato</span>
    <span class="ad__text">Same-day service across Marin. Upfront pricing. Call now.</span>
    <span class="ad__call"><Icon name="phone" size={16} /> Call (415) 555-0100</span>
  </div>
  <div class="ad" aria-hidden="true">
    <span class="ad__meta">Sponsored · competitor.com</span>
    <span class="ad__title ad__title--muted">Competitor Electric</span>
  </div>
</div>

<style>
  .mock {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
    color: var(--text-strong);
  }

  .mock__search {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    color: var(--muted);
  }

  .ad {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-top: 1px solid var(--line);
  }

  .ad--you {
    gap: 6px;
    padding-block: 20px;
    border-top: 0;
    background: var(--orange-50);
  }

  .ad__meta {
    font-size: 13px;
    color: var(--subtle);
  }

  .ad--you .ad__meta {
    color: var(--text-strong);
  }

  .ad__title {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--blue-700);
  }

  .ad__title--muted {
    font-size: 16px;
    color: var(--muted);
  }

  .ad__text {
    font-size: 14px;
    color: var(--muted);
  }

  .ad__call {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--blue-700);
  }
</style>
