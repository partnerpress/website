---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Grid from '@/components/Grid.astro';
import Button from '@/components/Button.astro';
import Placeholder from '@/components/Placeholder.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import AreaList from '@/components/AreaList.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import { SITE, OFFICES } from '@/config/site';
import { SERVICES } from '@/data/services';
import { LAS_CRUCES_AREAS } from '@/data/locations';

const office = OFFICES.nm;
const order = ['google-ads', 'local-seo', 'care', 'web-design'];
const local: Record<string, { title: string; summary: string }> = {
  'google-ads': {
    title: 'Google Ads in Las Cruces',
    summary: 'Show up at the top for the searches that bring calls, targeted to Las Cruces, Mesilla and El Paso.',
  },
  'local-seo': {
    title: 'Local SEO and Google Business Profile',
    summary: 'Get into the map pack with a complete profile, steady reviews and local pages Google trusts.',
  },
  care: { title: 'WordPress care plans', summary: 'Weekly updates, daily security scans and unlimited quick fixes. From $249 a month.' },
  'web-design': {
    title: 'Website design and rebuilds',
    summary: 'Replace an aging site with a fast WordPress site built to turn local visitors into calls.',
  },
};
const services = order.map((key) => SERVICES.find((s) => s.key === key)!);
---

<BaseLayout
  title="Las Cruces Web Design, SEO & Google Ads | PartnerPress"
  description="WordPress, Local SEO and Google Ads for Las Cruces and Doña Ana County businesses, from a local expert. Call (575) 517-4795."
  nav="locations"
  office="nm"
  schema={['nm']}
>
  <PageHero
    eyebrow="Las Cruces, NM · Doña Ana County"
    title="WordPress, Local SEO and Google Ads for Las Cruces businesses"
    tone="navy"
  >
    <Fragment slot="lead">
      I live and work in Las Cruces. Your website, your Google Business Profile and your ads, handled by one local expert who
      picks up the phone.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="call">or call <Phone office="nm" strong /></span>
    </Fragment>
    <Placeholder slot="aside" tone="dark" label="Local photo: Organ Mountains, Mesilla Plaza, or Shane with a Las Cruces client" />
  </PageHero>

  <Section>
    <SectionIntro title="What I do for Las Cruces businesses" />
    <Grid min={250} gap="20px">
      {services.map((s) => <ServiceCard service={s} detailed={false} title={local[s.key].title} summary={local[s.key].summary} />)}
    </Grid>
  </Section>

  <Section tone="subtle" compact>
    <AreaList title="Areas I serve" areas={LAS_CRUCES_AREAS}>Meetings in person around Las Cruces, or on video if that's easier.</AreaList>
  </Section>

  <Section>
    <Grid min={340}>
      <CaseStudyCard
        label="Las Cruces client story"
        result="[Las Cruces client] · [RESULT]"
        text="[Two sentences on the problem and what changed. Add a Las Cruces Google review here once the Las Cruces profile is live.]"
        image={false}
      />
      <div class="since">
        <h3>Since 2010</h3>
        <p>
          Hundreds of WordPress sites for service businesses, nonprofits and brands like Sutter Health and Grifols. 5.0 stars
          from 19 Google reviews.
        </p>
      </div>
    </Grid>
  </Section>

  <CtaBand title="Talk to a local WordPress expert">
    <address>
      {SITE.name}, {office.street}, {office.city}, {office.region}
      {office.postalCode} · <Phone office="nm" strong />
    </address>
  </CtaBand>
</BaseLayout>

<style>
  .call {
    font-size: 18px;
  }

  .since {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background: var(--blue-50);
    border-radius: var(--radius);
  }

  .since h3 {
    font-size: 22px;
    font-weight: 700;
  }

  .since p {
    font-size: 16px;
  }
</style>
