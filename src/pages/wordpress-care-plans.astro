---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Grid from '@/components/Grid.astro';
import Feature from '@/components/Feature.astro';
import PricingCard from '@/components/PricingCard.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { CARE_PLANS } from '@/data/plans';
import { CARE_FAQS } from '@/data/faqs';
---

<BaseLayout
  title="WordPress Maintenance Plans from $249/mo | PartnerPress"
  description="Weekly updates, daily security scans, backups, uptime monitoring and unlimited quick fixes. Month-to-month WordPress care plans from $249."
  nav="care"
>
  <PageHero eyebrow="WordPress care plans" title="Your WordPress site, handled. Every week." centered>
    <Fragment slot="lead">
      Updates, security, backups, monitoring and unlimited small fixes from a WordPress specialist who has been doing this
      since 2010. Month to month. Cancel any time.
    </Fragment>
  </PageHero>

  <Section id="plans" label="Plans">
    <Grid min={300} class="plans">
      {CARE_PLANS.map((plan) => <PricingCard plan={plan} showPerDay />)}
    </Grid>
  </Section>

  <Section tone="subtle" compact label="Plan details">
    <Grid min={240}>
      <Feature title="No contract">Month to month. Cancel at the end of any term.</Feature>
      <Feature title="Unlimited quick fixes">Any task that takes 30 minutes or less, at no extra charge.</Feature>
      <Feature title="If an update breaks something">
        I roll the site back to the last good version and tell you what happened.
      </Feature>
      <Feature title="WordPress only">A specialist, not a generalist. Other platforms can be converted to WordPress.</Feature>
    </Grid>
  </Section>

  <Section width="narrow">
    <FaqList faqs={CARE_FAQS} />
  </Section>

  <CtaBand title="Not sure which plan fits? Let's look at your site together." />
</BaseLayout>

<style>
  :global(.plans) {
    align-items: start;
  }
</style>
