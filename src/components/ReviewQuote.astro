---
import type { Review } from '@/data/reviews';

interface Props {
  review: Review;
  variant?: 'card' | 'feature' | 'tint';
}

const { review, variant = 'card' } = Astro.props;
---

<figure class:list={['quote', `quote--${variant}`]}>
  <blockquote>"{review.quote}"</blockquote>
  <figcaption>{review.name}, {review.note}</figcaption>
</figure>

<style>
  .quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  blockquote {
    margin: 0;
    color: var(--text-strong);
  }

  figcaption {
    font-size: 14px;
    color: var(--subtle);
  }

  .quote--card {
    padding: 22px 24px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .quote--card blockquote {
    font-size: 16px;
    line-height: 1.55;
  }

  .quote--tint {
    padding: 32px;
    background: var(--blue-50);
    border-radius: var(--radius);
  }

  .quote--tint figcaption {
    color: var(--muted);
  }

  .quote--feature {
    align-items: center;
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .quote--feature blockquote {
    font-family: var(--font-heading);
    font-size: clamp(21px, 1.2vw + 16px, 26px);
    line-height: 1.4;
    font-weight: 500;
    color: var(--ink);
  }

  .quote--feature figcaption {
    font-size: 15px;
    color: var(--muted);
  }
</style>
