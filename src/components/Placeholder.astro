---
// Dashed box marking a photo or screenshot that still needs to be supplied.
interface Props {
  label: string;
  ratio?: string;
  tone?: 'light' | 'dark' | 'plain';
  class?: string;
}

const { label, ratio = '4 / 3', tone = 'light', class: className } = Astro.props;
---

<div class:list={['placeholder', `placeholder--${tone}`, className]} style={`aspect-ratio: ${ratio}`}>
  <span>[{label}]</span>
</div>

<style>
  .placeholder {
    width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border-radius: var(--radius-lg);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
    text-align: center;
  }

  .placeholder--light {
    background: var(--blue-100);
    border: 2px dashed var(--blue-300);
    color: var(--blue-700);
  }

  .placeholder--dark {
    background: var(--blue-800);
    border: 2px dashed var(--blue-400);
    color: var(--blue-100);
  }

  .placeholder--plain {
    background: var(--surface-2);
    border-radius: 0;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
  }
</style>
